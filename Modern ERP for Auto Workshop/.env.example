# Em desenvolvimento local, aponta pro Django rodando na sua máquina.
# Em produção (Vercel/Netlify/Cloudflare Pages), configure esta mesma
# variável no painel do host apontando pra URL do backend publicado.
# Ex: VITE_API_URL=https://oficina-backend.onrender.com/api
VITE_API_URL=http://localhost:8000/api
