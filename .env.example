# Variáveis de ambiente do backend (Django). Em desenvolvimento local
# nenhuma delas é obrigatória — sem elas o projeto usa SQLite, DEBUG=True
# e CORS liberado pro Vite (localhost:5173). Em produção, configure todas
# no painel do host (Render, etc).

SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=False

# Hostnames que podem servir a API, separados por vírgula.
# Ex: oficina-backend.onrender.com
ALLOWED_HOSTS=

# String de conexão do Postgres (Neon, Supabase, Render Postgres, etc).
# Ex: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# URL(s) do front-end publicado, separadas por vírgula, sem barra no final.
# Ex: https://oficina-clara.vercel.app
CORS_ALLOWED_ORIGINS=

# Necessário para o /admin/ funcionar via HTTPS. Mesmo domínio do backend.
# Ex: https://oficina-backend.onrender.com
CSRF_TRUSTED_ORIGINS=
